<theme>
    <formatVersion>4</formatVersion>
    
    <!-- System View: The carousel entry -->
    <view name="system">
        <image name="background" extra="true">
            <path>./system.png</path>
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <size>1 1</size>
            <zIndex>1</zIndex>
        </image>
        <image name="logo_shadow" extra="true">
            <path>./logo.png</path>
            <pos>0.303 0.503</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.7 0.7</maxSize>
            <color>00000088</color>
            <zIndex>2</zIndex>
        </image>
        <image name="logo">
            <path>./logo.png</path>
            <pos>0.3 0.5</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.7 0.7</maxSize>
            <zIndex>3</zIndex>
        </image>
        <text name="description">
            <text>Fire4ArkOS: High-performance web browser. Desktop-class browsing on your ArkOS handheld.</text>
            <pos>0.3 0.88</pos>
            <origin>0.5 0.5</origin>
            <size>0.5 0.1</size>
            <fontSize>0.035</fontSize>
            <color>CCCCCCFF</color>
            <zIndex>4</zIndex>
        </text>
    </view>

    <!-- Gamelist View: Clean, Dark, and Professional -->
    <view name="basic, detailed, video">
        <image name="background" extra="true">
            <path>./system.png</path>
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <size>1 1</size>
            <zIndex>1</zIndex>
            <opacity>0.4</opacity>
        </image>
        
        <!-- Deep Dark Overlay -->
        <image name="overlay" extra="true">
            <path>./../assets/images/blank_1x1.png</path>
            <pos>0 0</pos>
            <size>1 1</size>
            <color>000000DD</color>
            <zIndex>2</zIndex>
        </image>

        <!-- Large Header Branding -->
        <image name="logo">
            <path>./logo.png</path>
            <pos>0.5 0.18</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.45 0.45</maxSize>
            <zIndex>3</zIndex>
        </image>

        <!-- Suppression of all "ugly" metadata colors/labels -->
        <text name="md_lbl_releasedate, md_releasedate, md_lbl_developer, md_developer, md_lbl_publisher, md_publisher, md_lbl_genre, md_genre, md_lbl_players, md_players, md_lbl_lastplayed, md_lastplayed, md_lbl_playcount, md_playcount">
            <visible>false</visible>
            <color>00000000</color>
        </text>

        <!-- The actual gamelist: Mono-color with orange selector -->
        <textlist name="gamelist">
            <pos>0.1 0.45</pos>
            <size>0.8 0.45</size>
            <alignment>center</alignment>
            <horizontalMargin>0.02</horizontalMargin>
            <fontSize>0.05</fontSize>
            <fontPath>./../assets/fonts/Roboto-Medium.ttf</fontPath>
            <color>999999FF</color>
            <selectedColor>FFFFFFFF</selectedColor>
            <selectorColor>FF7700AA</selectorColor>
            <zIndex>4</zIndex>
        </textlist>

        <!-- Clean Help Bar -->
        <help name="help">
            <pos>0.5 0.95</pos>
            <origin>0.5 0.5</origin>
            <fontSize>0.03</fontSize>
            <color>AAAAAAFF</color>
        </help>
    </view>
</theme>
