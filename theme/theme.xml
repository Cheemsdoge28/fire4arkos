<theme>
    <formatVersion>4</formatVersion>
    <view name="system">
        <image name="background" extra="true">
            <path>./system.png</path>
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <size>1 1</size>
        </image>
        <image name="logo">
            <path>./logo.png</path>
            <pos>0.5 0.3</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.6 0.3</maxSize>
        </image>
        <text name="description">
            <text>Fire4ArkOS: High-performance web browser for ArkOS. Desktop-class browsing on your handheld.</text>
            <pos>0.5 0.85</pos>
            <origin>0.5 0.5</origin>
            <size>0.8 0.1</size>
            <fontSize>0.03</fontSize>
            <color>DDDDDDFF</color>
        </text>
    </view>
    <view name="basic, detailed, video">
        <image name="logo">
            <path>./logo.png</path>
            <pos>0.5 0.1</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.4 0.15</maxSize>
        </image>
    </view>
</theme>
