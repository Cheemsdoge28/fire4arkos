<theme>
    <formatVersion>4</formatVersion>
    
    <!-- System View: The carousel entry -->
    <view name="system">
        <image name="background" extra="true">
            <path>./system.png</path>
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <size>1 1</size>
            <zIndex>1</zIndex>
        </image>
        <image name="logo_shadow" extra="true">
            <path>./logo.png</path>
            <pos>0.303 0.503</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.55 0.55</maxSize>
            <color>00000088</color>
            <zIndex>2</zIndex>
        </image>
        <image name="logo">
            <path>./logo.png</path>
            <pos>0.3 0.5</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.55 0.55</maxSize>
            <zIndex>3</zIndex>
        </image>
        <text name="description">
            <text>Fire4ArkOS: High-performance web browser. Desktop-class browsing on your ArkOS handheld.</text>
            <pos>0.3 0.88</pos>
            <origin>0.5 0.5</origin>
            <size>0.5 0.1</size>
            <fontSize>0.035</fontSize>
            <color>CCCCCCFF</color>
            <zIndex>4</zIndex>
        </text>
    </view>

    <!-- Gamelist View: Detailed view when you enter the folder -->
    <view name="basic, detailed, video">
        <image name="background" extra="true">
            <path>./system.png</path>
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <size>1 1</size>
            <zIndex>1</zIndex>
            <opacity>0.4</opacity>
        </image>
        
        <!-- Dark Overlay for readability -->
        <image name="overlay" extra="true">
            <path>./../assets/images/blank_1x1.png</path>
            <pos>0 0</pos>
            <size>1 1</size>
            <color>000000CC</color>
            <zIndex>2</zIndex>
        </image>

        <!-- Header Branding -->
        <image name="logo">
            <path>./logo.png</path>
            <pos>0.5 0.15</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.35 0.35</maxSize>
            <zIndex>3</zIndex>
        </image>

        <!-- The actual gamelist -->
        <textlist name="gamelist">
            <pos>0.1 0.4</pos>
            <size>0.8 0.5</size>
            <alignment>center</alignment>
            <horizontalMargin>0.02</horizontalMargin>
            <fontSize>0.045</fontSize>
            <fontPath>./../assets/fonts/Roboto-Medium.ttf</fontPath>
            <color>AAAAAAFF</color>
            <selectedColor>FFFFFFFF</selectedColor>
            <selectorColor>FF7700AA</selectorColor>
            <zIndex>4</zIndex>
        </textlist>

        <!-- Help Bar integration -->
        <help name="help">
            <pos>0.5 0.95</pos>
            <origin>0.5 0.5</origin>
            <fontSize>0.03</fontSize>
            <color>CCCCCCFF</color>
        </help>
    </view>
</theme>
