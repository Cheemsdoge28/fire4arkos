# Enforce LF line endings for scripts and text files to avoid /bin/bash^M issues on Linux devices
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
Makefile text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.service text eol=lf
/.gitattributes text eol=lf

# Binary files (keep as-is)
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.gz binary
*.tar.gz binary